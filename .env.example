# ---- Cotton Grade web client (Next.js) — copy to .env -------------------------
# Public origin of the FastAPI backend as seen from the BROWSER.
# Leave empty to route through the same-origin proxy at /api/backend (recommended in dev/docker).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the Next.js server forwards /api/backend/* when the proxy is used (server-side only).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Client-side pre-check of the upload size (must not exceed the backend MAX_UPLOAD_MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Optional: PostgreSQL URL for the Next.js /api/health database ping (Drizzle, src/db). Not needed for Cotton Grade itself.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Backend variables live in backend/.env — see backend/.env.example
# (MODEL_MODE, MODEL_REGISTRY_PATH, DATABASE_URL, UPLOAD_DIR, GRADCAM_DIR, MAX_UPLOAD_MB, CORS_ORIGINS, LOG_LEVEL ...)

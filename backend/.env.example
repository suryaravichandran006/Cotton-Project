# ---- Cotton Grade backend (copy to backend/.env) ---------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# mock  -> deterministic demo predictor, no trained model required
# trained -> loads the active model from MODEL_REGISTRY_PATH
MODEL_MODE=mock
MODEL_REGISTRY_PATH=models/registry.json
# Separate experimental cotton-quality model; independent of MODEL_MODE
QUALITY_MODEL_PATH=models/quality/active.json
MODEL_DEVICE=auto            # auto | cuda | mps | cpu
UNKNOWN_THRESHOLD=0.6        # calibrated-confidence threshold below which a prediction is "unknown"
VARIETIES_PATH=config/varieties.yaml

# SQLite for development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/cottonvision
DATABASE_URL=sqlite:///./backend/storage/cottonvision.db
UPLOAD_DIR=backend/storage/uploads
GRADCAM_DIR=backend/storage/gradcam
# PUBLIC_BASE_URL=https://api.example.com   # absolute origin used in image URLs (defaults to request host)

MAX_UPLOAD_MB=10
MAX_BATCH_SIZE=8
INFERENCE_TIMEOUT_S=60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API_KEY=change-me                 # when set, clients must send X-API-Key
RATE_LIMIT_PER_MINUTE=0             # 0 = disabled

# ---- advanced (defaults are fine for most deployments) -----------------------
# APP_NAME=Cotton Grade API
# API_PREFIX=/api/v1
# DEFAULT_TOP_K=3
# MAX_TOP_K=10
# MIN_IMAGE_DIMENSION=64
# MAX_IMAGE_DIMENSION=8000
# MAX_IMAGE_PIXELS=40000000
# MOCK_IMAGE_SIZE=224               # input size used by the mock predictor when no registry entry exists
# WARM_MODEL_ON_STARTUP=true        # run one dummy inference at start-up

FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install 'torch>=2.6' torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r /tmp/requirements.txt 'timm>=0.9.12'
COPY backend backend
COPY ml ml
COPY config config
COPY data/metadata data/metadata
COPY models/registry.json models/registry.json
RUN useradd --uid 10001 --create-home cotton \
    && mkdir -p backend/storage/uploads backend/storage/gradcam \
    && chown -R cotton:cotton backend/storage
USER cotton
EXPOSE 8000
CMD ["sh", "-c", "alembic -c backend/alembic.ini upgrade head && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV ANALYSIS_ONLY=true NEXT_PUBLIC_API_URL="" NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production ANALYSIS_ONLY=true NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
RUN addgroup -g 10001 cotton && adduser -D -u 10001 -G cotton cotton
COPY --from=build --chown=cotton:cotton /app/.next/standalone ./
COPY --from=build --chown=cotton:cotton /app/.next/static ./.next/static
COPY --from=build --chown=cotton:cotton /app/public ./public
USER cotton
EXPOSE 3000
CMD ["node", "server.js"]

# Site template for the existing nginx installation; verify the local port before enabling.
# Do not install another web server or replace another site's configuration.
limit_req_zone $binary_remote_addr zone=cotton_analysis_upload:10m rate=6r/m;

server {
    listen 80;
    server_name cotton.187-127-142-201.sslip.io;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/cotton-acme;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name cotton.187-127-142-201.sslip.io;
    ssl_certificate /etc/letsencrypt/live/cotton.187-127-142-201.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cotton.187-127-142-201.sslip.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 11m;

    location = /api/backend/api/v1/quality/analyze {
        limit_req zone=cotton_analysis_upload burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_request_buffering on;
    }
    location / {
        proxy_pass http://127.0.0.1:3180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
